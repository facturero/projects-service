# Plantilla de los secretos de producción de projects-service. NO se sube tal cual: se rellena en un archivo temporal y se cifra con
# SOPS (clave age pública de .sops.yaml) a config/secrets.production.enc, que es lo único que va al repo:
#
#   cp config/secrets.production.example /tmp/projects.env   # rellenar
#   sops -e --input-type dotenv --output-type dotenv /tmp/projects.env > config/secrets.production.enc
#   rm /tmp/projects.env
#
# Cuidado: el archivo con LF, sin retorno de carro (CRLF). Un \r al final de DB_HOST o DB_USER rompe la conexión (pasó con accounting).
# La base y el usuario se crean una vez en el MySQL del clúster:
#   CREATE DATABASE IF NOT EXISTS projects_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER IF NOT EXISTS 'projects_user'@'%' IDENTIFIED BY '<contraseña fuerte nueva>';
#   GRANT ALL PRIVILEGES ON projects_db.* TO 'projects_user'@'%';
DB_HOST=mysql-basic
DB_PORT=3306
DB_USER=projects_user
DB_PASSWORD=<la contraseña de projects_user>
DB_NAME=projects_db
RABBITMQ_URL=amqp://rabbitmq:5672
